#include "Render/GLShaderProg.hpp"
#include "Core/Log.hpp"

#include <fstream>

ShaderProgOpenGL::ShaderProgOpenGL()
 : m_programHandle{0}, m_linked{false}
{

}

ShaderProgOpenGL::~ShaderProgOpenGL()
{
   if(!m_programHandle)
      return;

     deleteDetachShaders();
   glDeleteProgram(m_programHandle);
}

void ShaderProgOpenGL::compileShader(const char* fname)
{
    std::string ext = getExtension(fname);
     std::map<std::string, GLSLTypes> extensions = getGlslExtensions();
      GLSLTypes extType = GLSLTypes::VERTEX;
        auto it = extensions.find(ext);
         if(it != extensions.end())
            extType = it->second;
          else
            LOG_ERROR("Extension unknown");

    compileShader(fname, extType);
}

void ShaderProgOpenGL::compileShader(const char* fname, GLSLTypes type)
{
     std::ifstream sFile{fname};
      if(!sFile)
       {
         LOG_ERROR("Shader file not found");  
       }

    std::stringstream shaderCode;
     shaderCode << sFile.rdbuf();
      sFile.close();
    
   compileShader(fname, type, shaderCode.str());
}
void ShaderProgOpenGL::compileShader(const char* fname,
                                     GLSLTypes type,
                                     const std::string& sCode)
{
    if(m_programHandle <= 0)
     {
      m_programHandle = glCreateProgram();
       if(m_programHandle == 0)
        LOG_ERROR("Error creating program handle");
     }

        GLuint shader = glCreateShader(type);
         if(shader == 0)
           {
                LOG_ERROR("Error creating shader");
           }
       const GLchar* shaderCodeArray[] = {sCode.c_str()};
         glShaderSource(shader, 1, shaderCodeArray, NULL);
          glCompileShader(shader);

     GLint result;
        glGetShaderiv(shader, GL_COMPILE_STATUS, &result);
         if(result == GL_FALSE)
           {
               std::string log;
             if(fname)
                log += static_cast<std::string>(fname) 
                      + " shader compilation failed\n";
             else
                 log += "Shader compilation faild\n";
               
               GLint logLen;
                glGetShaderiv(shader, GL_INFO_LOG_LENGTH, &logLen);
                 if(logLen > 0)
                  {
          std::string sLog(static_cast<unsigned int>(logLen), ' ');
                       GLsizei written;
                        glGetShaderInfoLog(shader,
                                           logLen,
                                           &written,
                                           &sLog[0]);
                    log += sLog;
                  }
              LOG_ERROR("{}", log);
           }
          else
             glAttachShader(m_programHandle, shader);
}
void ShaderProgOpenGL::linkShaders()
{
       glLinkProgram(m_programHandle);

        GLint status;
         glGetProgramiv(m_programHandle, GL_LINK_STATUS, &status);
          if(status == GL_FALSE)
            {
          std::string logMsg;
               logMsg += "Error linking shaders\n"; 
            GLint logLen;
              glGetProgramiv(m_programHandle, GL_INFO_LOG_LENGTH, &logLen);
                if(logLen > 0)
                 {
             std::string sLogMsg;

               sLogMsg.resize(static_cast<unsigned int>(logLen), ' ');
                       GLsizei written;

             glGetProgramInfoLog(m_programHandle,
                             logLen,
                             &written,
                             &sLogMsg[0]);

                     logMsg += sLogMsg;
                 }
                    LOG_ERROR("{}", logMsg);
            }
         else
           {
              m_linked = true;
               findUniformLocations();
           }
            
          deleteDetachShaders();
}

void ShaderProgOpenGL::use()
{
    if(m_programHandle <= 0 || m_linked == false)
         return;
       glUseProgram(m_programHandle);
}

void ShaderProgOpenGL::deleteDetachShaders()
{
      GLint nAttachedShaders;
        glGetProgramiv(m_programHandle,
                       GL_ATTACHED_SHADERS,
                       &nAttachedShaders);
         
std::vector<GLuint> shaders(static_cast<unsigned int>(nAttachedShaders));
       glGetAttachedShaders(m_programHandle,
                            nAttachedShaders,
                            NULL,
                            shaders.data());
       
         for(GLuint s : shaders)
          {
             glDetachShader(m_programHandle, s);
              glDeleteShader(s);
          }
}

void ShaderProgOpenGL::findUniformLocations()
{
     GLint nUniforms;
       GLint size;

        GLint maxLen;
          
      GLsizei written;
       GLenum type;
        GLchar* name;
   
  glGetProgramiv(m_programHandle, GL_ACTIVE_UNIFORM_MAX_LENGTH, &maxLen);
    glGetProgramiv(m_programHandle, GL_ACTIVE_UNIFORMS, &nUniforms);
       
      name = new GLchar[static_cast<unsigned int>(maxLen)];
       for(GLint i=0;i<nUniforms;++i)
        {
            glGetActiveUniform(m_programHandle,
                               static_cast<GLuint>(i),
                               maxLen,
                               &written,
                               &size,
                               &type,
                               name);
      m_uLocations[name] = glGetUniformLocation(m_programHandle, name);
        }
    delete[] name;
}

void ShaderProgOpenGL::printActiveAttribs()
{
     GLint nAttrib;
       GLint size;
         GLint location;

        GLint maxLen;
          
          GLsizei written;
           GLenum type;
            GLchar* name;

        glGetProgramiv(m_programHandle,
                       GL_ACTIVE_ATTRIBUTE_MAX_LENGTH,
                       &maxLen);

         glGetProgramiv(m_programHandle,
                        GL_ACTIVE_ATTRIBUTES,
                        &nAttrib);

       name = new GLchar[static_cast<unsigned int>(maxLen)];
        LOG_INFO("Active attributes:");
          for(GLint i=0;i<nAttrib;++i)
           {
                 glGetActiveAttrib(m_programHandle,
                                   static_cast<GLuint>(i),
                                   maxLen,
                                   &written,
                                   &size,
                                   &type,
                                   name);
             location = glGetAttribLocation(m_programHandle, name);
              LOG_INFO(to_string(location) + " "
                                           + to_string(name) + " "
                                           + getTypeString(type));
           }
      delete[] name;
}

void ShaderProgOpenGL::printActiveUniforms()
{
      GLint nUniforms;
        GLint maxLen;
         GLint location;
          GLint size;

       GLsizei written;
        GLenum type;
         GLchar* name;

           glGetProgramiv(m_programHandle,
                          GL_ACTIVE_UNIFORM_MAX_LENGTH,
                          &maxLen);
            glGetProgramiv(m_programHandle,
                           GL_ACTIVE_UNIFORMS,
                           &nUniforms);
   
       name = new GLchar[static_cast<unsigned int>(maxLen)];
          LOG_INFO("Active uniforms");
        for(GLint i=0;i<nUniforms;++i)
         {
            glGetActiveUniform(m_programHandle,
                               static_cast<GLuint>(i),
                               maxLen,
                               &written,
                               &size,
                               &type,
                               name);
              location = glGetUniformLocation(m_programHandle, name);

          LOG_INFO("{} {} {}", location, name, getTypeString(type));
         }
     delete[] name;
}
void ShaderProgOpenGL::printUniformBlocks()
{
      GLint nBlocks;
        GLint maxUniLen;
         GLint maxLen;
          GLint binding;

       GLsizei written;
         GLchar* name;

           glGetProgramiv(m_programHandle,
                          GL_ACTIVE_UNIFORM_BLOCK_MAX_NAME_LENGTH,
                          &maxLen);
            glGetProgramiv(m_programHandle,
                           GL_ACTIVE_UNIFORM_BLOCKS,
                           &nBlocks);
            glGetProgramiv(m_programHandle,
                           GL_ACTIVE_UNIFORM_MAX_LENGTH,
                           &maxUniLen);
   
     GLchar* uniName = new GLchar[static_cast<unsigned int>(maxUniLen)];  
       name = new GLchar[static_cast<unsigned int>(maxLen)];
          LOG_INFO("Active uniform blocks");
        for(GLint i=0;i<nBlocks;++i)
         {
            glGetActiveUniformBlockName(m_programHandle,
                               static_cast<GLuint>(i),
                               maxLen,
                               &written,
                               name);
             glGetActiveUniformBlockiv(m_programHandle,
                                       static_cast<GLuint>(i),
                                       GL_UNIFORM_BLOCK_BINDING,
                                       &binding);
               LOG_INFO("Uniform block {} {}", to_string(name),
                                            to_string(binding));

            GLint nUni;
             glGetActiveUniformBlockiv(m_programHandle,
                                       static_cast<GLuint>(i),
                                       GL_UNIFORM_BLOCK_ACTIVE_UNIFORMS,
                                       &nUni);
               GLint* uIndices = new GLint[static_cast<unsigned int>(nUni)];
                glGetActiveUniformBlockiv(m_programHandle,
                                          static_cast<GLuint>(i),
                          GL_UNIFORM_BLOCK_ACTIVE_UNIFORM_INDICES,
                                          uIndices);
                  for(GLint j=0;j<nUni;++j)
                   {
                       GLint size;
                        GLenum type;
                          glGetActiveUniform(m_programHandle,
                                          static_cast<unsigned int>(j),
                                          maxUniLen,
                                          &written,
                                          &size,
                                          &type,
                                          uniName);
        LOG_INFO("{} {}", to_string(uniName), getTypeString(type));
                   }
            delete[] uIndices;
         }
       delete[] uniName;
     delete[] name;
}

std::string ShaderProgOpenGL::getExtension(const char* fname)
{
      std::string fStr{fname};
       auto it = fStr.find_last_of(".");
        if(it != std::string::npos)
         {
            std::string ext = fStr.substr(it);
               if(ext == ".glsl")
                  {
                auto loc = fStr.find_last_of(".", it - 1);
                   if(loc == std::string::npos) 
                       {
                     loc = fStr.find_last_of("_",  it - 1);
                       }
                  if(loc != std::string::npos)
                     return fStr.substr(loc);
                }
              else
           return ext;
         }
      return "";
}

std::map<std::string, GLSLTypes> ShaderProgOpenGL::getGlslExtensions()
{
    std::map<std::string, GLSLTypes> e =
            {
              {".v", VERTEX},
              {".vert", VERTEX},
              {".vert.glsl", VERTEX},
              {"_vert.glsl", VERTEX},
              {".f", FRAGMENT},
              {".frag", FRAGMENT},
              {".frag.glsl", FRAGMENT},
              {"_frag.glsl", FRAGMENT}
            };
       return e;
}

GLint ShaderProgOpenGL::getUniformLocation(const char* name)
{
      auto it = m_uLocations.find(name);
       if(it == m_uLocations.end())
        {
            GLint location = glGetUniformLocation(m_programHandle, name);
             m_uLocations[name] = location;
        }
     return it->second;
}
void ShaderProgOpenGL::setUniform(const char* name,
                                  float x,
                                  float y,
                                  float z)
{
   GLint loc = getUniformLocation(name);
    glUniform3f(loc, x, y, z);
}
void ShaderProgOpenGL::setUniform(const char* name, const glm::vec2& v)
{
      GLint loc = getUniformLocation(name);
       glUniform2f(loc, v.x, v.y);
}
void ShaderProgOpenGL::setUniform(const char* name, const glm::vec3& v)
{
      GLint loc = getUniformLocation(name);
        glUniform3f(loc, v.x, v.y, v.z);
}
void ShaderProgOpenGL::setUniform(const char* name, const glm::vec4& v)
{
       GLint loc = getUniformLocation(name);
         glUniform4f(loc, v.x, v.y, v.z, v.w);
}
void ShaderProgOpenGL::setUniform(const char* name, const glm::mat2& m)
{
        GLint loc = getUniformLocation(name);
         glUniformMatrix2fv(loc, 1, GL_FALSE, &m[0][0]);
}
void ShaderProgOpenGL::setUniform(const char* name, const glm::mat3& m)
{
          GLint loc =  getUniformLocation(name);
           glUniformMatrix3fv(loc, 1, GL_FALSE, &m[0][0]);
}
void ShaderProgOpenGL::setUniform(const char* name, const glm::mat4& m)
{
         GLint loc = getUniformLocation(name);
            glUniformMatrix4fv(loc, 1, GL_FALSE, &m[0][0]);
}
void ShaderProgOpenGL::setUniform(const char* name, const GLuint& val)
{
        GLint loc = getUniformLocation(name);
               glUniform1ui(loc, val);
}
void ShaderProgOpenGL::setUniform(const char* name, const int& val)
{
         GLint loc = getUniformLocation(name);
            glUniform1i(loc, val);
}
void ShaderProgOpenGL::setUniform(const char* name, const float& val)
{
           GLint loc = getUniformLocation(name);
             glUniform1f(loc, val);
}
void ShaderProgOpenGL::setUniform(const char* name, const bool& val)
{
            GLint loc = getUniformLocation(name);
               glUniform1i(loc, val);
}
std::string ShaderProgOpenGL::getTypeString(GLenum type)
{
      switch(type)
       {
    case GL_INT:
          return "int";
    case GL_UNSIGNED_INT:
            return "uint";
    case GL_DOUBLE:
             return "double";
      case GL_BOOL:
        return "bool";
          case GL_FLOAT:
            return "float";
             case GL_FLOAT_VEC2:
               return "vec2";
                 case GL_FLOAT_VEC3:
                return "vec3";
                  case GL_FLOAT_VEC4:
                    return "vec4";
       case GL_FLOAT_MAT2:
         return "mat2";
        case GL_FLOAT_MAT3:
          return "mat3";
            case GL_FLOAT_MAT4:
           return "mat4";
       default:
        return "Unkown GL type";
       }
}

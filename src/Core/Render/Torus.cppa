#include "Torus.hpp"

#include <glm/gtc/matrix_transform.hpp>

Torus::Torus()
{

}

void Torus::initTorus(GLfloat innerRad,
                      GLfloat outerRad,
                      GLuint nSides,
                      GLuint nRings)
    //I probrably should study this
    //function more clearly before
    //I use it...
{
   GLuint faces = nSides * nRings;

    // LOG_INFO(to_string(faces));
      GLuint nVerts = nSides * (nRings + 1);

    // LOG_INFO(to_string(nVerts));

        // GLint vsize = 3 * nVerts;
         // GLint vsize = 2 * nVerts;
          // GLint vsize = 6 * nVerts;
  
         std::vector<GLuint> elem(6 * faces);

      std::vector<GLfloat> pos(3 * nVerts);
         std::vector<GLfloat> norms(3 * nVerts);

           // LOG_INFO(to_string(vsize));

            std::vector<GLfloat> tex(2 * nVerts);
    
  float ringFac = glm::two_pi<float>() / static_cast<float>(nRings);
  float sideFac = glm::two_pi<float>() / static_cast<float>(nSides);

            // LOG_INFO(to_string(ringFac));
            //  LOG_INFO(to_string(sideFac));
  
       unsigned int idx = 0;
        unsigned int texIdx = 0;

       // LOG_INFO(to_string(innerRad));
       //  LOG_INFO(to_string(outerRad));
  
          for(GLuint ring=0;ring<=nRings;++ring)
            {
    float u = static_cast<float>(ring) * ringFac;

                // LOG_INFO(to_string(u));
    
                 float cu = cos(u);
                  float su = sin(u);

                   // LOG_INFO("Cos: " + to_string(cu));
                   //  LOG_INFO("Sin: " + to_string(su));
              for(GLuint side=0;side<nSides;++side)
               {
      float v = static_cast<float>(side) * sideFac;

                   // LOG_INFO("Side: " + to_string(v));
      
               float cv = cos(v);
                float sv = sin(v);
                float r = outerRad + innerRad * cv;

                // float r = (outerRad + innerRad * cv);
               // GLfloat pos1 = r * cu;
               //  GLfloat pos2 = r * su;
               //   GLfloat pos3 = innerRad * sv;
      
                pos[idx] = r * cu;
                  pos[idx+1] = r * su;
                   pos[idx+2] = innerRad * sv;

                   // LOG_INFO("Pos1: " + to_string(pos1));
                   // LOG_INFO("Pos2: " + to_string(pos2));
                   // LOG_INFO("Pos3: " + to_string(pos3));
                  // GLfloat norm1 = cv * cu * r;
                  //  GLfloat norm2 = cv * su * r;
                  //   GLfloat norm3 = sv * r;
      
                       norms[idx] = cv * cu * r;
                        norms[idx+1] = cv * su * r;
                         norms[idx+2] = sv * r;

                   // LOG_INFO("Norm1: " + to_string(norm1));
                   // LOG_INFO("Norm2: " + to_string(norm2));
                   // LOG_INFO("Norm3: " + to_string(norm3));
                 // GLfloat tex1 = u / glm::two_pi<float>();
                 //  GLfloat tex2 = v / glm::two_pi<float>();
      
                  tex[texIdx] = u / glm::two_pi<float>();
                   tex[texIdx + 1] = v / glm::two_pi<float>();
                     texIdx += 2;

                   // LOG_INFO("Tex1: " + to_string(tex1));
                   // LOG_INFO("Tex2: " + to_string(tex2));
            // float len = sqrt(norm1 * norm1
            //                + norm2 * norm2
            //                + norm3 * norm3);
            float len = sqrt(norms[idx] * norms[idx]
                           + norms[idx+1] * norms[idx+1]
                           + norms[idx+2] * norms[idx+2]);
                     // LOG_INFO("Length: " + to_string(len));
                  // norm1 /= len;
                  //  norm2 /= len;
                  //   norm3 /= len;
                  norms[idx] /= len;
                   norms[idx+1] /= len;
                    norms[idx+2] /= len;
              idx += 3;
                       // LOG_INFO("Normalized1: " + to_string(norm1));
                       // LOG_INFO("Normalized2: " + to_string(norm2));
                       // LOG_INFO("Normalized3: " + to_string(norm3));
               }
            }

      idx = 0;
       for(GLuint ring=0;ring<nRings;++ring)
        {
           GLuint ringStart = ring * nSides;
             // LOG_INFO("Ring start: " + to_string(ringStart));
            GLuint nextRingStart = (ring+1) * nSides;
             // LOG_INFO("Next ring start: " + to_string(nextRingStart));
              for(GLuint side=0;side<nSides;++side)
               {
                  GLuint nextSide = (side+1) % nSides;
                   // LOG_INFO("Next side: " + to_string(nextSide));
                     // GLuint elem1 = ringStart + side;
                     //  GLuint elem2 = nextRingStart + side;
                     //   GLuint elem3 = nextRingStart + nextSide;
                     //    GLuint elem4 = ringStart + side;
                     //     GLuint elem5 = nextRingStart + nextSide;
                     //      GLuint elem6 = ringStart + nextSide;
                      elem[idx] = ringStart + side;
                       elem[idx+1] = nextRingStart + side;
                        elem[idx+2] = nextRingStart + nextSide;
                         elem[idx+3] = ringStart + side;
                          elem[idx+4] = nextRingStart + nextSide;
                           elem[idx+5] = ringStart + nextSide;
                  // LOG_INFO("Elem1: " + to_string(elem1));
                  // LOG_INFO("Elem2: " + to_string(elem2));
                  // LOG_INFO("Elem3: " + to_string(elem3));
                  // LOG_INFO("Elem4: " + to_string(elem4));
                  // LOG_INFO("Elem5: " + to_string(elem5));
                  // LOG_INFO("Elem6: " + to_string(elem6));
                 idx += 6; 
               }
        }
        
     initBuffers(&elem, &pos, &norms, &tex);
}

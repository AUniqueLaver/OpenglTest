void renderTriangle(Triangle& triangle,
           std::pair<int, int> winDim)
{
      glClear(GL_COLOR_BUFFER_BIT);
      glClear(GL_DEPTH_BUFFER_BIT);

      // SDL_Delay(175);

      triangle.m_prog.use();
      // triangle.m_prog.setUniform("sampler1", 0);

      float currentTime = float(SDL_GetTicks());

      glm::mat4 model = glm::mat4(1.0f);

      glm::mat4 view = glm::mat4(1.0f);

      float timeInSec = currentTime / 1000;

      glm::vec3 cameraDirection;

      cameraDirection.x = cos(glm::radians(triangle.m_yaw))
                      * cos(glm::radians(triangle.m_pitch));
  
      cameraDirection.y = sin(glm::radians(triangle.m_pitch));

      cameraDirection.z = sin(glm::radians(triangle.m_yaw))
                      * cos(glm::radians(triangle.m_pitch));

      // triangle.m_cam.m_cameraFront = glm::normalize(cameraDirection);

      view = glm::lookAt(triangle.m_cam.m_cameraPos,
                         triangle.m_cam.m_cameraFront + triangle.m_cam.m_cameraPos,
                         triangle.m_cam.m_cameraUp
                         );

  
      glm::mat4 proj = glm::mat4(1.0f);
      // glm::mat4 proj = triangle.m_proj;

      // float width = float(winDim.first) / 2;
      // float height = float(winDim.second) / 2;
      float width = float(winDim.first);
      float height = float(winDim.second);
      // float asecptRatio = float(winDim.first) / float(winDim.second); 
      float asecptRatio = width / height;
      // std::cout << width << " , " << height << '\n';
      // std::cout << asecptRatio << '\n';
  
      // proj = glm::ortho(-asecptRatio, asecptRatio, -1.0f, 1.0f, 0.1f, 100.0f);

      proj = glm::ortho(-1.0f, 1.0f, -1.0f, 1.0f, 0.1f, 100.0f);
  
      // proj = glm::perspective(glm::radians(triangle.m_fov), float(winDim.first)/float(winDim.second), 0.1f, 100.0f);
      // proj = glm::ortho(-asecptRatio, asecptRatio, -asecptRatio, asecptRatio, 0.1f, 100.0f);

 //      std::cout << "View" << '\n';
 //      for(int i = 0; i < 4; i++)
 //      {
 //      for(int j = 0; j < 4; j++)
 //      {
 //      std::cout << view[j][i] << " , ";
 //      }
 //      std::cout << '\n';
 //      }
 // 
 //      std::cout << "Proj" << '\n';
 //      for(int i = 0; i < 4; i++)
 //      {
 //      for(int j = 0; j < 4; j++)
 //      {
 //      std::cout << proj[j][i] << " , ";
 //      }
 //      std::cout << '\n';
 //      }
  

      triangle.m_prog.setUniform("view", view);
      triangle.m_prog.setUniform("proj", proj);

      glBindVertexArray(triangle.m_vaoHandle);

      // glActiveTexture(GL_TEXTURE0);
      // glBindTexture(GL_TEXTURE_2D, triangle.m_tex);
  
      if(triangle.m_drawLines)
       {
      glPolygonMode(GL_FRONT_AND_BACK, GL_LINE);
       }

      // model = glm::mat4(1.0f);
      // model = glm::translate(model, glm::vec3(1.0f, 1.0f, 0.0f));
      //  model = glm::rotate(model, 45.0f, glm::vec3(0.0f, 0.0f, 1.0f));
      //  model = glm::scale(model, glm::vec3(0.5f, 0.5f, 0.5f));
      // 
      //  // model = glm::rotate(model, currentTime / 1000, glm::vec3(0.0f, 0.0f, 1.0f));
      //  model = glm::scale(model, glm::vec3(0.5f, 0.5f, 0.5f));
      //
      //  triangle.m_prog.setUniform("model", model);
      //  glDrawElements(GL_TRIANGLES, 6, GL_UNSIGNED_INT, 0);
      //
       model = glm::mat4(1.0f);
       // model = glm::translate(model, glm::vec3(0.5f, 0.0f, 0.0f));

       // model = glm::rotate(model, currentTime / 1000, glm::vec3(0.0f, 0.0f, 1.0f));
       // model = glm::rotate(model, 45.0f, glm::vec3(0.0f, 0.0f, 1.0f));

      // glViewport(0, 0, winDim.first / 2, winDim.second);
      // // glViewport(0, 0, winDim.first, winDim.second);
      //
      glm::mat4 view1 = glm::mat4(1.0f); 
      view1 = glm::lookAt(triangle.m_cam1.m_cameraPos,
                         triangle.m_cam1.m_cameraFront + triangle.m_cam1.m_cameraPos,
                         triangle.m_cam1.m_cameraUp
                         );

      triangle.m_prog.setUniform("model", model);

      // glViewport(0, 0, winDim.first, winDim.second);
      glViewport(0, 0, winDim.first, winDim.second);
      glDrawArrays(GL_TRIANGLES, 0, 6);

      // // glDrawElements(GL_TRIANGLES, 6, GL_UNSIGNED_INT, 0);
      // glDrawArrays(GL_TRIANGLES, 0, 6);
  
      // glViewport(0, 0, int(winDim.first / 2), winDim.second);
      // glDrawArrays(GL_TRIANGLES, 0, 6);

      // glViewport(winDim.first / 2, 0, int(winDim.first / 2), winDim.second);
      // glDrawArrays(GL_TRIANGLES, 0, 6);
  
      // double funcTime = Time::secAndNsec();
      // for(int i=0;i<pow(10,6);i++)
      // {
      // glViewport(240, 320, int(winDim.first / 1.5), int(winDim.second / 1.75));
      
      // glViewport(0, 0, winDim.first, winDim.second);
      // glDrawArrays(GL_TRIANGLES, 0, 6);
      // }

      // std::cout << Time::secAndNsec() - funcTime << '\n';
      //
      // funcTime = Time::secAndNsec();
      // for(int i=0;i<pow(10,6);i++)
      // {
      // glDrawArrays(GL_TRIANGLES, 0, 6);
      // glDrawArrays(GL_TRIANGLES, 0, 6);

      // glViewport(0, 0, winDim.first / 2, winDim.second / 2);
      // glDrawArrays(GL_TRIANGLES, 0, 6);
      // glViewport(winDim.first / 2, 0, winDim.first / 2, winDim.second / 2);
      // glDrawArrays(GL_TRIANGLES, 0, 6);
      // glViewport(0, winDim.second / 2, winDim.first / 2, winDim.second / 2);
      // glDrawArrays(GL_TRIANGLES, 0, 6);
      // glViewport(winDim.first / 2, winDim.second / 2, winDim.first / 2, winDim.second / 2);
      // glDrawArrays(GL_TRIANGLES, 0, 6);

      // glViewport(winDim.first / 2, 0, winDim.first / 2, winDim.second);
      //
      // model = glm::mat4(1.0f);
